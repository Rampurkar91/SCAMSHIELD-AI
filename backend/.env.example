APP_ENV=development
# Omit DATABASE_URL for local SQLite only. Production: use PostgreSQL.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scamshield
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Optional, opt-in external checks. Never expose these to frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Local tools. OCR_LANG may be eng+hin+mar when those language packs are installed.
TESSERACT_CMD=
OCR_LANG=eng
# Set this to a local faster-whisper model directory, not a model to download per request.
WHISPER_MODEL_PATH=
# Optional trusted operator-trained artifact. Default: backend/models/sms.joblib
SMS_MODEL_PATH=

# Family sharing always requires verified email. Optionally gate scans too.
REQUIRE_EMAIL_VERIFICATION=false
# Production fails closed for binary scans unless an isolated worker is configured.
SCANNER_WORKER_URL=
# Alternative internal host; uses port 8090. Prefer URL when using TLS.
SCANNER_WORKER_HOST=
# Generate a separate random 32+ character secret, shared only by API and worker.
SCANNER_WORKER_KEY=
